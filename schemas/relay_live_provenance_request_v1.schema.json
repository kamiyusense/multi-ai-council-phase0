{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-ai-council.local/schemas/relay_live_provenance_request_v1.schema.json",
  "title": "Relay Live Provenance Verification Request v1",
  "description": "Static structural contract for requesting durable human provenance readback",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "state": {
      "type": "string",
      "enum": ["BLOCKED_UNKNOWN", "PROVENANCE_VERIFICATION_REQUIRED"]
    },
    "live_ready": {
      "type": "boolean",
      "const": false
    },
    "dispatch_allowed": {
      "type": "boolean",
      "const": false
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false
    },
    "provenance_verified": {
      "type": "boolean",
      "const": false
    },
    "retry_count": {
      "type": "integer",
      "const": 0
    },
    "fallback_state": {
      "type": "string",
      "const": "disabled"
    },
    "next_action": {
      "type": "string",
      "enum": ["RESOLVE_BLOCKERS", "READBACK_DURABLE_HUMAN_PROVENANCE"]
    },
    "approval_record_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "approval_packet_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_packet_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "durable_locator_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_record_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "state",
    "live_ready",
    "dispatch_allowed",
    "execution_authorized",
    "provenance_verified",
    "retry_count",
    "fallback_state",
    "next_action",
    "approval_record_sha256",
    "approval_packet_sha256",
    "snapshot_packet_sha256",
    "durable_locator_sha256",
    "expected_record_sha256",
    "provenance_request_sha256"
  ]
}
