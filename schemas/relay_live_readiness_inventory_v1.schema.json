{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relay Live Readiness Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "live_ready",
    "dispatch_allowed",
    "human_approval_required",
    "retry_count",
    "fallback_state",
    "unresolved_by_provider",
    "unresolved_count",
    "inventory",
    "packet_sha256"
  ],
  "properties": {
    "state": {
      "type": "string",
      "enum": ["UNRESOLVED", "PROOF_RECORDS_COMPLETE"]
    },
    "live_ready": { "type": "boolean", "const": false },
    "dispatch_allowed": { "type": "boolean", "const": false },
    "human_approval_required": { "type": "boolean", "const": true },
    "retry_count": { "type": "integer", "const": 0 },
    "fallback_state": { "type": "string", "const": "disabled" },
    "unresolved_count": { "type": "integer", "minimum": 0 },
    "unresolved_by_provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openai", "anthropic", "google"],
      "properties": {
        "openai": { "type": "integer", "minimum": 0 },
        "anthropic": { "type": "integer", "minimum": 0 },
        "google": { "type": "integer", "minimum": 0 }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openai", "anthropic", "google"],
      "properties": {
        "openai": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            ".*": { "$ref": "#/$defs/proof_record" }
          }
        },
        "anthropic": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            ".*": { "$ref": "#/$defs/proof_record" }
          }
        },
        "google": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            ".*": { "$ref": "#/$defs/proof_record" }
          }
        }
      }
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "proof_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_ref"],
      "oneOf": [
        {
          "properties": {
            "status": { "const": "UNKNOWN" },
            "evidence_ref": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "const": "CONFIRMED" },
            "evidence_ref": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
