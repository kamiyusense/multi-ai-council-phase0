{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.local/schemas/relay_live_readiness_pipeline_v1.schema.json",
  "title": "Relay Live Readiness Pipeline",
  "description": "Schema for the relay live readiness pipeline output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "live_ready",
    "dispatch_allowed",
    "human_approval_required",
    "retry_count",
    "fallback_state",
    "inventory_state",
    "unresolved_count",
    "unresolved_by_provider",
    "inventory_packet_sha256",
    "provider_states",
    "blocking_providers",
    "bundle_packet_sha256",
    "pipeline_packet_sha256"
  ],
  "properties": {
    "state": {
      "type": "string",
      "enum": ["BLOCKED_UNKNOWN", "READY_FOR_HUMAN_APPROVAL"]
    },
    "live_ready": {
      "type": "boolean",
      "const": false
    },
    "dispatch_allowed": {
      "type": "boolean",
      "const": false
    },
    "human_approval_required": {
      "type": "boolean",
      "const": true
    },
    "retry_count": {
      "type": "integer",
      "const": 0
    },
    "fallback_state": {
      "type": "string",
      "const": "disabled"
    },
    "inventory_state": {
      "type": "string",
      "enum": ["BLOCKED_UNKNOWN", "UNRESOLVED", "PROOF_RECORDS_COMPLETE"]
    },
    "unresolved_count": {
      "type": "integer",
      "minimum": -1
    },
    "unresolved_by_provider": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "inventory_packet_sha256": {
      "type": ["string", "null"],
      "pattern": "^([a-f0-9]{64})?$"
    },
    "provider_states": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openai": { "type": "string", "enum": ["BLOCKED_UNKNOWN", "READY_FOR_HUMAN_APPROVAL"] },
        "anthropic": { "type": "string", "enum": ["BLOCKED_UNKNOWN", "READY_FOR_HUMAN_APPROVAL"] },
        "google": { "type": "string", "enum": ["BLOCKED_UNKNOWN", "READY_FOR_HUMAN_APPROVAL"] }
      }
    },
    "blocking_providers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["openai", "anthropic", "google"]
      },
      "uniqueItems": true
    },
    "bundle_packet_sha256": {
      "type": ["string", "null"],
      "pattern": "^([a-f0-9]{64})?$"
    },
    "pipeline_packet_sha256": {
      "type": ["string", "null"],
      "pattern": "^([a-f0-9]{64})?$"
    }
  }
}
