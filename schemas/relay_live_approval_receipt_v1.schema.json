{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relay Live Approval Receipt",
  "description": "Static structural validation of a human approval record for Relay Phase 0 POC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "live_ready",
    "dispatch_allowed",
    "execution_authorized",
    "provenance_verified",
    "retry_count",
    "fallback_state",
    "decision",
    "scope",
    "one_shot",
    "approval_packet_sha256",
    "snapshot_packet_sha256",
    "next_action",
    "approval_record_sha256"
  ],
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "BLOCKED_UNKNOWN",
        "STRUCTURALLY_VALID_APPROVAL_RECORD",
        "NON_APPROVAL_DECISION"
      ]
    },
    "live_ready": {
      "type": "boolean",
      "const": false
    },
    "dispatch_allowed": {
      "type": "boolean",
      "const": false
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false
    },
    "provenance_verified": {
      "type": "boolean",
      "const": false
    },
    "retry_count": {
      "type": "integer",
      "const": 0
    },
    "fallback_state": {
      "type": "string",
      "const": "disabled"
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVE_FIRST_LIVE_POC",
        "REJECT",
        "DEFER",
        "UNKNOWN"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "FIRST_LIVE_POC_ONLY",
        "UNKNOWN"
      ]
    },
    "one_shot": {
      "type": "boolean"
    },
    "approval_packet_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot_packet_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "next_action": {
      "type": "string",
      "enum": [
        "RESOLVE_BLOCKERS",
        "VERIFY_DURABLE_HUMAN_PROVENANCE",
        "NO_LIVE_ACTION"
      ]
    },
    "approval_record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
