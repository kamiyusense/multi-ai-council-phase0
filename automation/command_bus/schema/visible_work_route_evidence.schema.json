{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","command_id","correlation_id","target_head_expected","target_head_observed",
    "target_tree_expected","target_tree_observed","scheduled_task_title","associated_chat_state",
    "associated_chat_metadata_exposed","associated_chat_user_visible","associated_chat_stable",
    "scheduled_entry_available","associated_chat_identifier_persisted",
    "native_thread_delegation_capability","native_tool_presence",
    "native_thread_delegation_live_tested","external_send_attempted","browser_started",
    "new_work_creation_tested","human_auth_started","jules_started","model_started",
    "credential_material_persisted","retry_count","fallback_used","route_decision",
    "evidence_refs","created_at"
  ],
  "properties": {
    "schema_version":{"const":1},
    "command_id":{"type":"string","minLength":1},
    "correlation_id":{"type":"string","minLength":1},
    "target_head_expected":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "target_head_observed":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "target_tree_expected":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "target_tree_observed":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "scheduled_task_title":{"type":"string","minLength":1},
    "associated_chat_state":{"enum":["ASSOCIATED_CHAT_USABLE","ASSOCIATED_CHAT_PRESENT_BUT_UNVERIFIED","ASSOCIATED_CHAT_NOT_USER_VISIBLE","ASSOCIATED_CHAT_UNAVAILABLE","UNKNOWN"]},
    "associated_chat_metadata_exposed":{"enum":[true,false,"UNKNOWN"]},
    "associated_chat_user_visible":{"enum":[true,false,"UNKNOWN"]},
    "associated_chat_stable":{"enum":[true,false,"UNKNOWN"]},
    "scheduled_entry_available":{"enum":[true,false,"UNKNOWN"]},
    "associated_chat_identifier_persisted":{"const":false},
    "native_thread_delegation_capability":{"enum":["AVAILABLE","UNAVAILABLE","UNKNOWN","SKIPPED_HIGHER_PRIORITY"]},
    "native_tool_presence":{"type":"object","additionalProperties":false,"required":["send_message_to_thread","read_thread","list_threads","create_thread","thread_resume","equivalent_existing_work_delegation"],"properties":{"send_message_to_thread":{"enum":[true,false,"UNKNOWN"]},"read_thread":{"enum":[true,false,"UNKNOWN"]},"list_threads":{"enum":[true,false,"UNKNOWN"]},"create_thread":{"enum":[true,false,"UNKNOWN"]},"thread_resume":{"enum":[true,false,"UNKNOWN"]},"equivalent_existing_work_delegation":{"enum":[true,false,"UNKNOWN"]}}},
    "native_thread_delegation_live_tested":{"const":false},
    "external_send_attempted":{"const":false},
    "browser_started":{"const":false},
    "new_work_creation_tested":{"const":false},
    "human_auth_started":{"const":false},
    "jules_started":{"const":false},
    "model_started":{"const":false},
    "credential_material_persisted":{"const":false},
    "retry_count":{"const":0},
    "fallback_used":{"const":false},
    "route_decision":{"enum":["ASSOCIATED_CHAT","NATIVE_DELEGATION_CANDIDATE","NEEDS_CHATGPT_WEB_PREFLIGHT","UNKNOWN"]},
    "evidence_refs":{"type":"array","items":{"type":"string"}},
    "created_at":{"type":"string","minLength":1}
  }
}
