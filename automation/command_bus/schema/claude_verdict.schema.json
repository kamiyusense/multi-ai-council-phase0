{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","verdict_id","loop_id","round","generation","correlation_id","backend_mode","decision","reasons","next_prompt","evidence_refs","expected_target_head","expected_target_tree","terminal","retry","fallback","execution_mode","model_executed","external_send_attempted"],"properties":{"schema_version":{"const":1},"verdict_id":{"type":"string","minLength":1},"loop_id":{"type":"string","minLength":1},"round":{"type":"integer","minimum":1,"maximum":1000},"correlation_id":{"type":"string","minLength":1},"backend_mode":{"enum":["JULES_BACKEND","CLAUDE_BACKEND"]},"decision":{"enum":["CONTINUE","COMPLETE","BLOCKED","UNKNOWN"]},"reasons":{"type":"array","items":{"type":"string","minLength":1}},"next_prompt":{"type":["string","null"]},"evidence_refs":{"type":"array","items":{"type":"string","minLength":1}},"expected_target_head":{"type":"string","pattern":"^[0-9a-f]{40}$"},"expected_target_tree":{"type":"string","pattern":"^[0-9a-f]{40}$"},"terminal":{"type":"boolean"},"retry":{"const":0},"fallback":{"const":"disabled"},"execution_mode":{"const":"PREPARE_ONLY"},"model_executed":{"const":false},"external_send_attempted":{"const":false},"generation":{"type":"integer","minimum":1}},"allOf":[{"if":{"properties":{"decision":{"const":"CONTINUE"}},"required":["decision"]},"then":{"properties":{"next_prompt":{"type":"string","minLength":1,"pattern":".*\\S.*"},"terminal":{"const":false}}},"else":{"properties":{"next_prompt":{"type":"null"},"terminal":{"const":true}}}}]}