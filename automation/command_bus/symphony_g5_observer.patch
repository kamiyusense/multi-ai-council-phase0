diff --git a/elixir/lib/symphony_elixir/g5_observer.ex b/elixir/lib/symphony_elixir/g5_observer.ex
new file mode 100644
index 0000000..ad95984
--- /dev/null
+++ b/elixir/lib/symphony_elixir/g5_observer.ex
@@ -0,0 +1,122 @@
+defmodule SymphonyElixir.G5Observer do
+  @moduledoc """
+  Best-effort signed observations of one worker lifetime. The orchestrator owns
+  all terminal decisions. An unlinked writer keeps file I/O off the scheduler;
+  it never dispatches, retries, adopts results or holds up worker termination.
+  """
+
+  require Logger
+
+  @spec start() :: map() | nil
+  def start do
+    with path when is_binary(path) and path != "" <- System.get_env("SYMPHONY_G5_OBSERVER_EVENTS"),
+         key_hex when is_binary(key_hex) <- System.get_env("SYMPHONY_G5_OBSERVER_KEY_HEX"),
+         {:ok, key} when byte_size(key) >= 32 <- Base.decode16(key_hex, case: :mixed) do
+      owner = self()
+      run_id = Base.encode16(:crypto.strong_rand_bytes(16), case: :lower)
+      writer = spawn(fn -> write_lifetime(Process.monitor(owner), path, key, run_id, nil) end)
+      %{worker_run_id: run_id, writer: writer, workspace: nil}
+    else
+      _ -> nil
+    end
+  rescue
+    _ -> nil
+  catch
+    _, _ -> nil
+  end
+
+  @spec started(map(), String.t(), map()) :: map()
+  def started(entry, issue_id, runtime_info) do
+    case Map.get(entry, :g5_observer) do
+      %{worker_run_id: run_id, writer: writer, workspace: nil} = observation
+      when is_pid(writer) ->
+        workspace = runtime_info[:workspace_path]
+
+        if runtime_info[:g5_worker_run_id] == run_id and is_binary(workspace) and
+             String.starts_with?(workspace, "/") do
+          send(writer, {:started, issue_id, workspace})
+          Map.put(entry, :g5_observer, %{observation | workspace: workspace})
+        else
+          entry
+        end
+
+      _ ->
+        entry
+    end
+  rescue
+    _ -> entry
+  catch
+    _, _ -> entry
+  end
+
+  @spec terminal(map(), String.t()) :: :ok
+  def terminal(entry, status) do
+    case Map.get(entry, :g5_observer) do
+      %{writer: writer} when is_pid(writer) -> send(writer, {:terminal, status})
+      _ -> :ok
+    end
+
+    :ok
+  rescue
+    _ -> :ok
+  catch
+    _, _ -> :ok
+  end
+
+  @spec discard(map() | nil) :: :ok
+  def discard(observation) do
+    if is_map(observation) and is_pid(observation[:writer]), do: send(observation.writer, :discard)
+    :ok
+  end
+
+  defp write_lifetime(owner_ref, path, key, run_id, identity) do
+    receive do
+      {:started, issue_id, workspace} when is_nil(identity) ->
+        append(path, key, run_id, issue_id, workspace, "STARTED", "RUNNING")
+        write_lifetime(owner_ref, path, key, run_id, {issue_id, workspace})
+
+      {:terminal, status} when status in ["WORKER_COMPLETED", "WORKER_FAILED", "WORKER_STOPPED"] ->
+        if identity do
+          {issue_id, workspace} = identity
+          append(path, key, run_id, issue_id, workspace, "TERMINAL", status)
+        else
+          Logger.warning("G5 terminal observation unavailable: worker workspace identity missing")
+        end
+
+      :discard ->
+        :ok
+
+      {:DOWN, ^owner_ref, :process, _pid, _reason} ->
+        :ok
+
+      _ ->
+        write_lifetime(owner_ref, path, key, run_id, identity)
+    end
+  end
+
+  defp append(path, key, run_id, issue_id, workspace, kind, status) do
+    # Operator pre-creates a private regular JSONL file outside model workspaces.
+    # Reject a missing/non-regular target in the writer, never in the scheduler.
+    with {:ok, %{type: :regular}} <- File.lstat(path) do
+      payload = %{
+        protocol: "SYMPHONY_G5_WORKER_OBSERVATION_V1",
+        issue_id: issue_id,
+        attempt_number: String.to_integer(String.slice(run_id, 0, 15), 16) + 1,
+        worker_run_id: run_id,
+        kind: kind,
+        workspace: workspace,
+        status: status
+      }
+
+      payload_json = Jason.encode!(payload)
+      mac = Base.encode16(:crypto.mac(:hmac, :sha256, key, payload_json), case: :lower)
+      File.write!(path, Jason.encode!(%{payload_json: payload_json, mac: mac}) <> "\n", [:append])
+    else
+      _ -> Logger.warning("G5 observation append unavailable: target is not a regular file")
+    end
+  rescue
+    _ -> Logger.warning("G5 observation append failed; upstream lifecycle unchanged")
+  catch
+    _, _ -> Logger.warning("G5 observation append failed; upstream lifecycle unchanged")
+  end
+end
