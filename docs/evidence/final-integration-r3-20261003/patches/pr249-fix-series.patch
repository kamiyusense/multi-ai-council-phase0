+            "state": "CONSUMED",
+            "loop_id": "loop-1",
+            "round": 1,
+            "correlation_id": "loop-1-round-1",
+            "expected_target_head": self.head_sha_1,
+            "expected_target_tree": self.tree_sha
+        }
+        next_action_re = prepare_next_action(
