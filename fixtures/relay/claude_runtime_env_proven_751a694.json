{
  "_comment": "Environment of the 'claude' service in the proven Path A configuration (repo commit 751a694). The human's PC compose file was read on 2026-10-14 and showed the same 15 entries. No proxy variables. Used only by tests and by the static docker-argument builder.",
  "env": {
    "ANTHROPIC_BASE_URL": "http://gate:8080",
    "PHASE0_TRANSPORT_MODE": "CONTAINER_INTERNAL",
    "CLAUDE_CODE_MAX_RETRIES": "0",
    "CLAUDE_CODE_MAX_TURNS": "1",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "CLAUDE_CODE_SKIP_PROMPT_HISTORY": "1",
    "CLAUDE_CODE_RESUME_INTERRUPTED_TURN": "0",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_DISABLE_AGENT_VIEW": "1",
    "CLAUDE_AGENT_SDK_DISABLE_BUILTIN_AGENTS": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_UPDATES": "1"
  },
  "image": "phase0-claude-runtime:2.1.283",
  "network_service_name": "internal",
  "volume": "claude-auth:/home/node/.claude",
  "user": "1000:1000"
}
